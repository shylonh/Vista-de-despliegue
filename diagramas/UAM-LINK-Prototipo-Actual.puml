@startuml
title UAM LINK - 02 - Prototipo actual
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
note "ESTADO ACTUAL: archivos HTML independientes, datos ficticios y ejecucion local; sin backend ni base de datos conectada." as Alcance
node "Computadora del usuario" as pc <<device>> {
node "Navegador web local" as browser <<executionEnvironment>> {
artifact "UAM-LINK-entrada.html" as inputfile
artifact "UAM-LINK.html" as outputfile
component "Formulario de solicitud" as input
component "Agenda y reportes de ejemplo" as output
}
}
note "Acceso: lectura local con file://. No hay conexion ni intercambio de datos entre los dos HTML.\nLas descargas CSV/HTML y la impresion/PDF se producen en el cliente; no prueban persistencia en servidor." as local
inputfile ..> input : <<manifest>>
outputfile ..> output : <<manifest>>
@enduml
